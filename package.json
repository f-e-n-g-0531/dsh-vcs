{
  "name": "@feng0531/dsh-vcs",
  "version": "0.8.1",
  "private": false,
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "description": "Git and SVN change preview with confirmed safe local Git branch switching for DSH",
  "exports": {
    ".": "./index.mjs",
    "./client": "./dist/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.mjs",
    "frontend-assets.mjs",
    "vcs.mjs",
    "branch-switch.mjs",
    "branch-switch-host.mjs",
    "branch-create-host.mjs",
    "branch-create-preview.mjs",
    "git-branch-create.mjs",
    "branch-delete-preview.mjs",
    "git-branch-delete.mjs",
    "src/branch-delete-plan.mjs",
    "src/verified-branch-delete-plan.mjs",
    "tag-create-host.mjs",
    "tag-create-preview.mjs",
    "tag-object-publish.mjs",
    "git-tag-create.mjs",
    "src/git-tag-object.mjs",
    "src/verified-tag-plan.mjs",
    "lightweight-tag-host.mjs",
    "lightweight-tag-preview.mjs",
    "git-lightweight-tag-create.mjs",
    "src/lightweight-tag-plan.mjs",
    "confirmed-operation.mjs",
    "index-change.mjs",
    "index-change-host.mjs",
    "index-stage-host.mjs",
    "partial-stage-host.mjs",
    "partial-unstage-host.mjs",
    "line-index-host.mjs",
    "commit-host.mjs",
    "amend-host.mjs",
    "latest-commit.mjs",
    "src/verified-commit-metadata.mjs",
    "commit-preview.mjs",
    "src/settled-reads.mjs",
    "commit-object-publish.mjs",
    "git-object-store.mjs",
    "git-ref-cas.mjs",
    "src/git-commit-object.mjs",
    "src/index-tree.mjs",
    "src/commit-plan.mjs",
    "src/amend-plan.mjs",
    "src/verified-commit.mjs",
    "src/verified-commit-plan.mjs",
    "index-lock.mjs",
    "git-blob-store.mjs",
    "src/git-index.mjs",
    "src/partial-index.mjs",
    "src/line-index.mjs",
    "git-history.mjs",
    "conflict-stages.mjs",
    "image-preview.mjs",
    "text-content.mjs",
    "workspace-large-text.mjs",
    "repository-path.mjs",
    "local-command.mjs",
    "src/svn-identity.mjs",
    "src/svn-target.mjs",
    "src/svn-path.mjs",
    "src/svn-revision.mjs",
    "src/commit-signature.mjs",
    "src/reflog.mjs",
    "src/operation-budget.mjs",
    "src/historical-access.mjs",
    "src/content-search.mjs",
    "src/preview-capabilities.mjs",
    "dist",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/RELEASING.md"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test --test-concurrency=2 test/*.test.mjs",
    "check": "npm run build && npm test",
    "prepare": "npm run build",
    "prepack": "npm run check",
    "verify:package": "node scripts/verify-package.mjs",
    "test:install": "node scripts/test-install.mjs",
    "test:host-compat": "node scripts/test-host-compat.mjs",
    "test:release": "node scripts/run-release-tests.mjs",
    "test:preflight": "node scripts/test-preflight.mjs",
    "test:browser": "node scripts/monaco-fixture.mjs && node scripts/run-isolated-browser.mjs",
    "test:performance": "node scripts/performance-baseline.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2 || 0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-rc.5 || 0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": { "optional": true }
  },
  "dependencies": {
    "fast-xml-parser": "^5.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/f-e-n-g-0531/dsh-vcs.git"
  },
