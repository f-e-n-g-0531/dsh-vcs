  "bugs": {
    "url": "https://github.com/f-e-n-g-0531/dsh-vcs/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "git",
    "svn",
    "diff"
  ]
}
